{
  "name": "@ditta/colophon",
  "type": "module",
  "version": "0.0.5",
  "private": false,
  "description": "Colophon used for all ditta projects",
  "author": "ditta <hello@ditta.studio>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dittastudio/colophon.git"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/lib.d.ts",
        "default": "./dist/lib.es.js"
      },
      "require": {
        "types": "./dist/lib.d.ts",
        "default": "./dist/lib.umd.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest --dom",
    "test:ui": "vitest --dom --ui",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.13.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.21",
    "eslint": "^9.27.0",
    "happy-dom": "^17.4.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.1.4"
  }
}
